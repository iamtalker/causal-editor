{
  "name": "causal-editor-android",
  "version": "1.0.0",
  "private": true,
  "description": "인과 편집기 안드로이드 앱 (Capacitor)",
  "scripts": {
    "copy-web": "node scripts/copy-web.js",
    "sync": "node scripts/copy-web.js && cap sync android",
    "build:apk": "node scripts/copy-web.js && cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "7.6.10"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10"
  }
}
